{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable this probe"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Pull secrets, merged with global.imagePullSecrets",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "envFromRef": {
      "type": "object",
      "description": "Map of environment variable name to the Secret/ConfigMap key it reads from",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        },
        "required": ["name", "key"]
      }
    },
    "componentCommon": {
      "type": "object",
      "description": "Fields shared by manager, gateway and ui",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Image repository"
            },
            "tag": {
              "type": "string",
              "description": "Image tag (defaults to Chart.appVersion if not set)"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["repository"]
        },
        "imagePullSecrets": {
          "$ref": "#/definitions/imagePullSecrets"
        },
        "podSecurityContext": {
          "type": "object",
          "description": "Pod-level security settings"
        },
        "securityContext": {
          "type": "object",
          "description": "Container-level security settings"
        },
        "resources": {
          "type": "object",
          "description": "Resource limits and requests",
          "properties": {
            "limits": {
              "type": "object"
            },
            "requests": {
              "type": "object"
            }
          }
        },
        "affinity": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "strategy": {
          "type": "object",
          "description": "Deployment strategy"
        },
        "priorityClassName": {
          "type": "string"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "command": {
          "type": "array",
          "description": "Override the container command",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Extra environment variables, as a plain map",
          "additionalProperties": {
            "type": "string"
          }
        },
        "envFromSecrets": {
          "$ref": "#/definitions/envFromRef"
        },
        "envFromConfigMap": {
          "$ref": "#/definitions/envFromRef"
        },
        "envFromFiles": {
          "type": "array",
          "description": "Load every key of a ConfigMap or Secret as environment variables",
          "items": {
            "type": "object"
          }
        },
        "initContainers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "lifecycle": {
          "type": "object",
          "description": "Container lifecycle hooks"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "livenessProbeCustom": {
          "type": "object",
          "description": "Replace the liveness probe entirely"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "readinessProbeCustom": {
          "type": "object",
          "description": "Replace the readiness probe entirely"
        },
        "startupProbe": {
          "$ref": "#/definitions/probe"
        },
        "startupProbeCustom": {
          "type": "object",
          "description": "Replace the startup probe entirely"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": ["string", "integer"]
            },
            "maxUnavailable": {
              "type": ["string", "integer"]
            }
          }
        },
        "dnsPolicy": {
          "type": "string"
        },
        "dnsConfig": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "type": "object",
          "description": "Custom Deployment labels"
        },
        "annotations": {
          "type": "object",
          "description": "Custom Deployment annotations"
        },
        "pod": {
          "type": "object",
          "description": "Custom Pod labels and annotations",
          "properties": {
            "labels": {
              "type": "object"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "componentServiceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "componentService": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Settings shared by every component",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "description": "Registry prefixed to every image repository"
        },
        "imagePullSecrets": {
          "$ref": "#/definitions/imagePullSecrets"
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "String to partially override dwpk.fullname template (will maintain the release name)"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "String to fully override dwpk.fullname template"
    },
    "manager": {
      "description": "Configure the controller manager deployment",
      "allOf": [
        { "$ref": "#/definitions/componentCommon" },
        {
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Set to false to skip manager installation"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of manager replicas"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gatewayHost": {
              "type": "string",
              "description": "SSH hostname published in Workspace status.endpoint"
            },
            "gitSSHEncryptionKey": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "boolean"
                }
              }
            },
            "extraVolumeMounts": {
              "type": "array",
              "description": "Additional volumeMounts on the manager container",
              "items": {
                "type": "object"
              }
            },
            "extraVolumes": {
              "type": "array",
              "description": "Additional volumes on the manager pod",
              "items": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "gateway": {
      "description": "Configure the SSH gateway deployment",
      "allOf": [
        { "$ref": "#/definitions/componentCommon" },
        {
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Set to false to skip gateway installation"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "extraArgs": {
              "type": "array",
              "description": "Extra arguments appended after --listen-address and --host-key-path",
              "items": {
                "type": "string"
              }
            },
            "listenAddress": {
              "type": "string",
              "description": "Address passed to the gateway --listen-address flag"
            },
            "hostKey": {
              "type": "object",
              "description": "SSH host key configuration",
              "properties": {
                "path": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string"
                }
              }
            },
            "serviceAccount": {
              "allOf": [{ "$ref": "#/definitions/componentServiceAccount" }],
              "description": "ServiceAccount configuration for the gateway"
            },
            "service": {
              "allOf": [{ "$ref": "#/definitions/componentService" }],
              "description": "Gateway Service configuration"
            }
          }
        }
      ]
    },
    "ui": {
      "description": "Configure the UI deployment",
      "allOf": [
        { "$ref": "#/definitions/componentCommon" },
        {
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Set to false to skip UI installation"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "listenAddress": {
              "type": "string",
              "description": "Listen address passed through DWPK__UI_LISTEN_ADDRESS"
            },
            "kubeconfig": {
              "type": "string",
              "description": "Optional DWPK__UI_KUBECONFIG override"
            },
            "gatewayHost": {
              "type": "string",
              "description": "Public gateway host shown in generated SSH commands"
            },
            "baseURL": {
              "type": "string",
              "description": "Public base URL used to derive default OAuth callback URLs"
            },
            "sessionTTL": {
              "type": "string",
              "description": "Session TTL passed through DWPK__UI_SESSION_TTL"
            },
            "cookieSecure": {
              "type": "boolean"
            },
            "logLevel": {
              "type": "string",
              "enum": ["debug", "info", "warn", "error"]
            },
            "basePath": {
              "type": "string",
              "description": "Optional path prefix when the UI is served under a non-root path"
            },
            "tokenNamespace": {
              "type": "string",
              "description": "Namespace holding the API token Secrets"
            },
            "localAuth": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "namespace": {
                  "type": "string"
                }
              }
            },
            "serviceAccount": {
              "allOf": [{ "$ref": "#/definitions/componentServiceAccount" }],
              "description": "ServiceAccount configuration for the UI"
            },
            "service": {
              "allOf": [{ "$ref": "#/definitions/componentService" }],
              "description": "UI Service configuration"
            },
            "ingress": {
              "type": "object",
              "description": "Optional Ingress for the UI Service",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "className": {
                  "type": "string"
                },
                "annotations": {
                  "type": "object"
                },
                "hosts": {
                  "type": "array"
                },
                "tls": {
                  "type": "array"
                }
              }
            },
            "gateway": {
              "type": "object",
              "description": "Optional Kubernetes Gateway API route for the UI Service, as an alternative to ui.ingress",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "create": {
                  "type": "boolean"
                },
                "className": {
                  "type": "string"
                },
                "listeners": {
                  "type": "array"
                },
                "annotations": {
                  "type": "object"
                },
                "parentRefs": {
                  "type": "array"
                },
                "hostnames": {
                  "type": "array"
                },
                "rules": {
                  "type": "array"
                }
              }
            },
            "oauth": {
              "type": "object",
              "description": "OAuth provider configuration",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "description": "Existing Secret containing provider client secrets"
                },
                "entraID": {
                  "type": "object",
                  "properties": {
                    "clientID": { "type": "string" },
                    "issuerURL": { "type": "string" },
                    "redirectURL": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "adminGroups": { "type": "array", "items": { "type": "string" } },
                    "userGroups": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "google": {
                  "type": "object",
                  "properties": {
                    "clientID": { "type": "string" },
                    "issuerURL": { "type": "string" },
                    "redirectURL": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "adminGroups": { "type": "array", "items": { "type": "string" } },
                    "userGroups": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "gitLab": {
                  "type": "object",
                  "properties": {
                    "clientID": { "type": "string" },
                    "issuerURL": { "type": "string" },
                    "redirectURL": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "adminGroups": { "type": "array", "items": { "type": "string" } },
                    "userGroups": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "keycloak": {
                  "type": "object",
                  "properties": {
                    "clientID": { "type": "string" },
                    "issuerURL": { "type": "string" },
                    "redirectURL": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "adminGroups": { "type": "array", "items": { "type": "string" } },
                    "userGroups": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "gitHub": {
                  "type": "object",
                  "description": "GitHub has no group claim, so no adminGroups/userGroups option",
                  "properties": {
                    "clientID": { "type": "string" },
                    "redirectURL": { "type": "string" },
                    "clientSecretKey": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "rbac": {
      "type": "object",
      "description": "RBAC configuration",
      "properties": {
        "namespaced": {
          "type": "boolean",
          "description": "false: ClusterRole/ClusterRoleBinding (all namespaces). true: Role/RoleBinding (release namespace only)"
        },
        "helpers": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Install convenience admin/editor/viewer roles for CRDs"
            }
          }
        }
      }
    },
    "adminBootstrap": {
      "type": "object",
      "description": "Local admin API token bootstrap",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Set to false to skip local admin token bootstrap entirely"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Owner identity for the admin, unique across UserSpaces"
        },
        "userSpaceName": {
          "type": "string"
        },
        "password": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "description": "ServiceAccount configuration for the manager",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Install default ServiceAccount provided"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "crd": {
      "type": "object",
      "description": "Custom Resource Definitions",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Install CRDs with the chart"
        },
        "keep": {
          "type": "boolean",
          "description": "Keep CRDs when uninstalling"
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Controller metrics endpoint",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer"
        },
        "secure": {
          "type": "boolean",
          "description": "Enable secure metrics: HTTPS with certs/auth (true) or HTTP (false)"
        }
      }
    },
    "certManager": {
      "type": "object",
      "description": "cert-manager integration for TLS certificates",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "webhook": {
      "type": "object",
      "description": "Webhook server configuration",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "prometheus": {
      "type": "object",
      "description": "Prometheus ServiceMonitor for metrics scraping",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "description": "Network policies for controlling traffic flow",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
